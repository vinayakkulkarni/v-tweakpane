{
  "name": "v-tweakpane",
  "version": "0.3.4",
  "private": false,
  "description": "Vue 3 wrapper for Tweakpane — build floating GUI panels for tweaking values, debugging generative art, and design tools.",
  "keywords": [
    "Vue tweakpane",
    "tweakpane",
    "v-tweakpane",
    "vue-tweakpane.js"
  ],
  "homepage": "https://v-tweakpane.vinayakkulkarni.dev",
  "bugs": {
    "url": "https://github.com/vinayakkulkarni/v-tweakpane/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Vinayak Kulkarni",
    "email": "inbox.vinayak@gmail.com",
    "url": "https://vinayakkulkarni.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vinayakkulkarni/v-tweakpane.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dist/index.css": "./dist/index.css"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "typecheck": "vue-tsc --noEmit -p tsconfig.test.json && pnpm --filter ./example run typecheck",
    "build": "vp pack",
    "test": "vp test run",
    "build:demo": "pnpm run build && pnpm --filter ./example run build",
    "deploy": "pnpm run build:demo && wrangler deploy",
    "prepare": "is-ci || husky"
  },
  "dependencies": {
    "@tweakpane/plugin-essentials": "^0.2.1",
    "tweakpane": "^4.0.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^26.6.5",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "lint-staged": "^17.6.0",
    "typescript": "6.0.3",
    "unplugin-vue": "^8.0.0",
    "vite-plus": "^1.4.0",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13",
    "wrangler": "^4.152.0"
  },
  "peerDependencies": {
    "@tweakpane/plugin-essentials": "^0.2.1",
    "tweakpane": "^4.0.4",
    "vue": "^3.4.7"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26.x"
    }
  },
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61"
}
